    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>LOGIC</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>OPCODE A_32 B_32 R_32
loop(i,10000)
 let a = random(1&lt;&lt;32);
 let b = random(1&lt;&lt;32);
(0)	(a)	(b)	(~(a&amp;b))
(1)	(a)	(b)	(a|b)
(2)	(a)	(b)	(a&amp;b)
(3)	(a)	(b)	(~(a|b))

end loop</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="0" y="120"/>
